rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Approved Firebase Authentication UIDs for access to private user data.
    function approved() {
      return request.auth != null && request.auth.uid in [
        'Yk0WCbGfCOfiy7fnXqMgcfxjvze2', 'm6ybLppag7e9ky7UMVqnc80gwxA3'
      ];
    }
    match /progress/{uid} {
      allow read, write: if approved() && request.auth.uid == uid;
    }
    match /users/{uid}/{area}/{entryId} {
      allow read, write: if approved() && request.auth.uid == uid
        && area in ['grcProgress', 'studyEntries'];
    }
  }
}
