rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A user is approved if they are one of the built-in accounts, or the admin has created an
    // active roster/{uid} entry for them (v83). The roster lets the admin add users (e.g. pentest
    // accounts) without a code change. Each account still only ever reads its own study data.
    function rostered() {
      let r = /databases/$(database)/documents/roster/$(request.auth.uid);
      return exists(r) && get(r).data.get('active', true) == true;
    }
    function approved() {
      return request.auth != null && (request.auth.uid in [
        'Yk0WCbGfCOfiy7fnXqMgcfxjvze2', 'm6ybLppag7e9ky7UMVqnc80gwxA3', 'pt8WaB9gHuMU5U8qhtKTJCEHC0r1', 'CJOZImCPj4VieLsezwCytLOXVKP2',
        'GnHicVzeiHWGfr5p8KrR5K2aMWA3'
      ] || rostered());
    }
    // The admin can read every learner's progress and unlock a locked CISA study plan.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'Yk0WCbGfCOfiy7fnXqMgcfxjvze2';
    }
    // Once a learner locks their CISA study plan, the plan fields cannot change
    // (topic completion, notes, logs, mock exams etc. can). Only the admin can unlock.
    function planIntact() {
      let before = resource.data.get('cisa', {});
      let after = request.resource.data.get('cisa', {});
      return before.get('planLock', {}).get('locked', false) != true || (
        after.get('planLock', null) == before.get('planLock', null) &&
        after.get('plans', null) == before.get('plans', null) &&
        after.get('planMode', null) == before.get('planMode', null) &&
        after.get('topicEdits', null) == before.get('topicEdits', null) &&
        after.get('customTasks', null) == before.get('customTasks', null) &&
        after.get('order', null) == before.get('order', null) &&
        after.get('hidden', null) == before.get('hidden', null)
      );
    }
    // Set by the admin in coach/{uid}.access: when chat is disabled or the learner is blocked,
    // the learner cannot send chat messages (existing messages are kept) — except an
    // "unblock request" (kind 'appeal') from the blocked screen.
    function learnerMuted(uid) {
      let c = /databases/$(database)/documents/coach/$(uid);
      return exists(c) && (get(c).data.get('access', {}).get('chatOff', false) == true
        || get(c).data.get('access', {}).get('blocked', false) == true);
    }
    // Blocked = blocked by the admin, or auto-blocked after 10+ days away (activity/{uid}.autoBlock)
    // and not unblocked by the admin since (coach/{uid}.access.unblockedAt).
    // A blocked learner can still sign in, see the blocked screen and send an unblock request,
    // but the server refuses their study data (read and write) until the admin unblocks them.
    function accessOf(uid) {
      let c = /databases/$(database)/documents/coach/$(uid);
      return exists(c) ? get(c).data.get('access', {}) : {};
    }
    function autoBlockOf(uid) {
      let a = /databases/$(database)/documents/activity/$(uid);
      return exists(a) ? get(a).data.get('autoBlock', {}) : {};
    }
    function isBlocked(uid) {
      let acc = accessOf(uid);
      return acc.get('blocked', false) == true
        || autoBlockOf(uid).get('at', 0) > acc.get('unblockedAt', 0);
    }
    // The learner's own app may record a new auto-block but can never remove or roll one back.
    function autoBlockKept() {
      let b = resource.data.get('autoBlock', null);
      let a = request.resource.data.get('autoBlock', null);
      return b == null || a == b || (a != null && a.get('at', 0) > b.get('at', 0));
    }
    match /progress/{uid} {
      allow read: if approved() && (isAdmin() || (request.auth.uid == uid && !isBlocked(uid)));
      allow create: if approved() && request.auth.uid == uid && !isBlocked(uid);
      allow update: if approved() && (isAdmin() || (request.auth.uid == uid && !isBlocked(uid) && planIntact()));
      allow delete: if approved() && request.auth.uid == uid && !isBlocked(uid);
    }
    // Activity log: written by the learner's own app, read by the learner and the admin.
    // Learners can add and update entries but cannot delete them.
    match /activity/{uid} {
      allow read: if approved() && (request.auth.uid == uid || isAdmin());
      allow create: if approved() && request.auth.uid == uid;
      allow update: if approved() && request.auth.uid == uid && autoBlockKept();
      match /days/{day} {
        allow read: if approved() && (request.auth.uid == uid || isAdmin());
        allow create, update: if approved() && request.auth.uid == uid;
      }
    }
    // Coaching set by the admin (targets, assigned work, audit trail, remote sign-out).
    // The learner can read it; only the admin can write it.
    match /coach/{uid} {
      allow read: if approved() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    // Chat and popup messages between the admin and one learner.
    // Each side can only send as itself, mark the other side's messages as seen,
    // and edit or delete its own messages for 5 minutes after sending.
    match /chats/{uid}/messages/{msgId} {
      allow read: if approved() && (request.auth.uid == uid || isAdmin());
      allow create: if approved() && (
        (request.auth.uid == uid && !isAdmin() && request.resource.data.from == 'learner'
          && (!learnerMuted(uid) || (request.resource.data.get('kind', '') == 'appeal' && request.resource.data.text is string && request.resource.data.text.size() <= 1000))) ||
        (isAdmin() && request.resource.data.from == 'admin'));
      allow update: if approved() && (
        // the recipient marks a message as seen
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt'])
          && ((request.auth.uid == uid && resource.data.from == 'admin') || (isAdmin() && resource.data.from == 'learner')))
        ||
        // the sender edits or deletes their own message within 5 minutes (6 allowed for clock differences)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'title', 'editedAt', 'deleted'])
          && request.time.toMillis() < resource.data.at + 360000
          && resource.data.get('deleted', false) != true
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          && ((resource.data.from == 'learner' && request.auth.uid == uid && !isAdmin()) || (resource.data.from == 'admin' && isAdmin())))
      );
      allow delete: if isAdmin();
    }
    match /users/{uid}/{area}/{entryId} {
      allow read, write: if approved() && request.auth.uid == uid
        && area in ['grcProgress', 'studyEntries'] && !isBlocked(uid);
    }
    // Roster: the access level (role, name, active) the admin assigns to each account.
    // A user may read only their own entry; only the admin may create or change entries.
    match /roster/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
