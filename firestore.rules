rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Approved Firebase Authentication UIDs for access to private user data.
    function approved() {
      return request.auth != null && request.auth.uid in [
        'Yk0WCbGfCOfiy7fnXqMgcfxjvze2', 'm6ybLppag7e9ky7UMVqnc80gwxA3'
      ];
    }
    // The admin can read every learner's progress and unlock a locked CISA study plan.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'Yk0WCbGfCOfiy7fnXqMgcfxjvze2';
    }
    // Once a learner locks their CISA study plan, the plan fields cannot change
    // (topic completion, notes, logs, mock exams etc. can). Only the admin can unlock.
    function planIntact() {
      let before = resource.data.get('cisa', {});
      let after = request.resource.data.get('cisa', {});
      return before.get('planLock', {}).get('locked', false) != true || (
        after.get('planLock', null) == before.get('planLock', null) &&
        after.get('plans', null) == before.get('plans', null) &&
        after.get('planMode', null) == before.get('planMode', null) &&
        after.get('topicEdits', null) == before.get('topicEdits', null) &&
        after.get('customTasks', null) == before.get('customTasks', null) &&
        after.get('order', null) == before.get('order', null) &&
        after.get('hidden', null) == before.get('hidden', null)
      );
    }
    match /progress/{uid} {
      allow read: if approved() && (request.auth.uid == uid || isAdmin());
      allow create: if approved() && request.auth.uid == uid;
      allow update: if approved() && (isAdmin() || (request.auth.uid == uid && planIntact()));
      allow delete: if approved() && request.auth.uid == uid;
    }
    // Activity log: written by the learner's own app, read by the learner and the admin.
    // Learners can add and update entries but cannot delete them.
    match /activity/{uid} {
      allow read: if approved() && (request.auth.uid == uid || isAdmin());
      allow create, update: if approved() && request.auth.uid == uid;
      match /days/{day} {
        allow read: if approved() && (request.auth.uid == uid || isAdmin());
        allow create, update: if approved() && request.auth.uid == uid;
      }
    }
    // Coaching set by the admin (targets, assigned work, audit trail, remote sign-out).
    // The learner can read it; only the admin can write it.
    match /coach/{uid} {
      allow read: if approved() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    // Chat and popup messages between the admin and one learner.
    // Each side can only send as itself, mark the other side's messages as seen,
    // and edit or delete its own messages for 5 minutes after sending.
    match /chats/{uid}/messages/{msgId} {
      allow read: if approved() && (request.auth.uid == uid || isAdmin());
      allow create: if approved() && (
        (request.auth.uid == uid && !isAdmin() && request.resource.data.from == 'learner') ||
        (isAdmin() && request.resource.data.from == 'admin'));
      allow update: if approved() && (
        // the recipient marks a message as seen
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt'])
          && ((request.auth.uid == uid && resource.data.from == 'admin') || (isAdmin() && resource.data.from == 'learner')))
        ||
        // the sender edits or deletes their own message within 5 minutes (6 allowed for clock differences)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'title', 'editedAt', 'deleted'])
          && request.time.toMillis() < resource.data.at + 360000
          && resource.data.get('deleted', false) != true
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          && ((resource.data.from == 'learner' && request.auth.uid == uid && !isAdmin()) || (resource.data.from == 'admin' && isAdmin())))
      );
      allow delete: if isAdmin();
    }
    match /users/{uid}/{area}/{entryId} {
      allow read, write: if approved() && request.auth.uid == uid
        && area in ['grcProgress', 'studyEntries'];
    }
  }
}
